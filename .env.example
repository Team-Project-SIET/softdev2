POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-too
PGADMIN_PORT=5050

DATABASE_URL=postgresql+psycopg://logistics:change-me@localhost:5432/logistics
APP_ENV=development
SQL_ECHO=false

# LINE Messaging API channel access token. Leave blank until push messaging is configured.
LINE_CHANNEL_ACCESS_TOKEN=

# Single depot used by the CVRP optimizer (Bangkok example coordinates).
DEPOT_NAME="Main Depot"
DEPOT_LATITUDE=13.756331
DEPOT_LONGITUDE=100.501762
